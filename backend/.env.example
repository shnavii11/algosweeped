# ── Supabase / Postgres ───────────────────────────────────────────────────────
# From: Supabase → Project Settings → Database → Connection string → URI
# Use the "Transaction" pooler URL (port 6543) for serverless; direct (5432) for local.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server/scraper ONLY — never expose to frontend

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:[YOUR-TOKEN]@[YOUR-ENDPOINT].upstash.io:6379

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=           # personal access token, read:user + repo scopes

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=            # generate: openssl rand -hex 32
JWT_EXPIRE_MINUTES=10080   # 7 days

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
LLM_PROVIDER=gemini   # options: gemini | groq | mistral

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production set this to your deployed frontend origin (e.g. https://algosweeped.vercel.app)
FRONTEND_URL=http://localhost:5173

# ── Optional: LeetCode session for premium-gated fields ──────────────────────
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=

# ── Optional: fetch CF problem statement HTML (slow, adds ~2h) ───────────────
FETCH_CF_STATEMENTS=false
